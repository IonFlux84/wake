<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect trailing slashes, using the address as it was requested (it may
    # have been rewritten into public/ by the .htaccess one folder up)...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} ^\S+\s(/[^?\s]*?)/+(\?\S*)?\s
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller, as an absolute address (see the
    # .htaccess one folder up): the folder of this file is taken from the
    # request, so no document root is needed.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=WAKE_PUBLIC_BASE:%1]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:WAKE_PUBLIC_BASE}/index.php [L]
</IfModule>
